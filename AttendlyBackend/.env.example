# Attendly Mobile Backend - Environment Variables Template
# Copy this file to .env and adjust values for your local environment.
# Never commit .env or secrets to version control.

PROJECT_NAME="Attendly Mobile API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Local PostgreSQL database for Attendly Mobile (DO NOT use production or old Attendly Neon DB)
DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/attendly_mobile_db"

# Security (JWT authentication will be implemented in Phase 3)
JWT_SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=86400
